shell-integration = zsh

# font-family = AdwaitaMono Nerd Font
font-size = 13
font-style = Regular
font-thicken = false
# font-thicken-strength = 30

mouse-hide-while-typing = true

cursor-style = block
cursor-style-blink = true

shell-integration-features = no-cursor

window-padding-x = 5
window-padding-y = 5
window-decoration = false

confirm-close-surface = false
clipboard-paste-protection = false
unfocused-split-opacity = 1.0

theme = TokyoNight

selection-background = #364A82
selection-foreground = #C0CAF5

background-opacity = 0.90
background-blur = 30

macos-titlebar-proxy-icon = hidden
title = " "

# adjust-cell-height= 5%
# adjust-cell-width=-10%

# removing the alt + number because it's binded to tmux tilish
keybind = alt+one=unbind
keybind = alt+two=unbind
keybind = alt+three=unbind
keybind = alt+four=unbind
keybind = alt+five=unbind
keybind = alt+left=unbind
keybind = alt+right=unbind

macos-option-as-alt = true
