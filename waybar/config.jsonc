{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "modules-left": ["custom/archicon", "hyprland/workspaces"],
  "modules-center": ["clock#time", "clock#date"],
  "modules-right": [
    "temperature",
    "cpu",
    "memory",
    "disk",
    "pulseaudio",
    "network",
    "battery",
    "custom/power_btn",
  ],
  "custom/archicon": {
    "format": "",
    "on-click": "wofi --show drun",
    "tooltip": false,
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "default": "",
    },
    "persistent-workspaces": { "*": 5 },
    "disable-scroll": true,
    "all-outputs": true,
    "show-special": true,
  },

  "clock#date": {
    "interval": 10,
    "format": "  {:%Y %b,%e}", // Icon: calendar-alt
    "tooltip-format": "{:%e %B %Y}",
  },

  "clock#time": {
    "interval": 1,
    "format": "{:%I:%M %p}",
    "tooltip": false,
    "timezones": ["Asia/Kathmandu"],
  },

  "temperature": {
    "critical-threshold": 80,
    "interval": 5,
    "format": "{icon}  {temperatureC}°C",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true,
  },

  "cpu": {
    "interval": 1,
    "format": "  {usage}%",
    "max-length": 10,
  },

  "memory": {
    "interval": 1,
    "format": "  {}%",
    "max-length": 10,
    "tooltip": true,
    "tooltip-format": "Memory - {used:0.1f}GB used",
  },

  "disk": {
    "interval": 500,
    "format": "󰋊  {percentage_used}%",
    "path": "/",
    "tooltip": true,
    "tooltip-format": "HDD - {used} used out of {total} on {path} ({percentage_used}%)",
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "tooltip": false,
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
  },

  "network": {
    "interval": 5,
    "format-wifi": " ", // Icon: wifi
    "format-ethernet": " ", // Icon: ethernet
    "format-disconnected": "⚠  Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}",
  },

  "battery": {
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "  {icon}  {capacity}%",
    "format-discharging": "{icon}  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true,
  },

  "custom/power_btn": {
    "format": "",
    "on-click": "sh -c '(sleep 0.5s; wlogout --protocol layer-shell)' & disown",
    "tooltip": false,
  },
}
